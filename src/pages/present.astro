---
import Base from '../layouts/Base.astro';

// The interview deck. Same content spine as the site (Ruralvía → Flame → Erneszt),
// distilled to one beat per slide. Each slide carries the data-theme of its universe,
// so the deck inherits the whole token system for free.
type Slide = {
  variant: 'title' | 'arc' | 'split' | 'gallery' | 'statement' | 'metrics' | 'close';
  theme?: string;
  kicker: string;
  headline: string;
  body?: string;
  quote?: string;
  meta?: string;
  image?: { src: string; alt: string };
  images?: { src: string; alt: string }[];
  items?: { index: string; title: string; label: string }[];
  metrics?: { num: string; lbl: string }[];
};

const slides: Slide[] = [
  {
    variant: 'title',
    kicker: 'Portfolio · 2026',
    headline: 'I define the system and make the decisions that set the direction.',
    body: 'Then I lead the execution and adoption to make it real.',
    meta: 'Manu Barranco · Product design leader · 15+ years in digital product, the last eight in banking',
  },
  {
    variant: 'arc',
    kicker: 'The arc',
    headline: 'Three projects. One story.',
    body: 'Each one raises the altitude: design the product, design the system that scales the people who design products, design with AI as the material.',
    items: [
      { index: '01', title: 'Ruralvía', label: 'Product design, end to end' },
      { index: '02', title: 'Flame', label: 'Systems at scale' },
      { index: '03', title: 'Erneszt', label: 'AI from scratch' },
    ],
  },
  {
    variant: 'split',
    theme: 'ruralvia',
    kicker: 'Ruralvía · Caja Rural · 2018–2019',
    headline: 'The research led.',
    body: '201 survey responses, desk research and five in-depth interviews across Spain. People used the app to check their balance and move money. What they asked for was someone in their corner.',
    quote: 'The Caja Rural app talks Greek to me.',
    image: { src: '/work/ruralvia/persona-board.webp', alt: 'User research synthesis board' },
  },
  {
    variant: 'split',
    theme: 'ruralvia',
    kicker: 'Ruralvía · The vision',
    headline: 'El Experto: an expert in your corner.',
    body: 'Not a chatbot. A contextual advisor built on Caja Rural’s real asset: closeness. And underneath, the floor the research demanded: the complete transfer flow, every screen and every state.',
    image: { src: '/work/ruralvia/expert-chat.webp', alt: 'El Experto, a contextual advisor inside the app' },
  },
  {
    variant: 'split',
    theme: 'ruralvia',
    kicker: 'Ruralvía · The outcome',
    headline: 'The industry caught up.',
    body: 'What we designed in 2018 is what Cleo, Revolut and N26 are building today: proactive advice, contextual alerts, a product that works for you.',
    image: { src: '/work/ruralvia/ruralvia.webp', alt: 'Ruralvía’s redesigned home screen, in production' },
  },
  {
    variant: 'split',
    theme: 'flame',
    kicker: 'Flame · Santander · 2020–2024',
    headline: 'The problem wasn’t consistency. It was adoption.',
    body: 'A global system imposed top-down dies ignored. Flame chose adoption over control: a global foundation, local layers, and teams that could move fast without fragmenting the platform.',
    image: { src: '/work/flame/sticker-sheet.webp', alt: 'Flame component sticker sheet' },
  },
  {
    variant: 'gallery',
    theme: 'flame',
    kicker: 'Flame · Governance',
    headline: 'An agreement, not a rulebook.',
    body: '350+ designers across 11 markets. None of them reported to me. Guidance over enforcement, support over control.',
    images: [
      { src: '/work/flame/contribution-model.webp', alt: 'Flame contribution model' },
      { src: '/work/flame/distribution-model.webp', alt: 'Flame distribution model' },
    ],
  },
  {
    variant: 'statement',
    theme: 'flame',
    kicker: 'Flame · The European tier',
    headline: 'The European tier outgrew the global reference.',
    body: 'Co-designed by several countries through facilitation and explicit trade-offs. Consensus outran hierarchy.',
  },
  {
    variant: 'metrics',
    theme: 'flame',
    kicker: 'Flame 4.0 · The proof',
    headline: 'Breaking the system to keep it alive.',
    body: 'A deliberate breaking change instead of inherited debt: new governance, new architecture, a protected core.',
    metrics: [
      { num: '1,780+', lbl: 'components governed' },
      { num: '350+', lbl: 'designers' },
      { num: '10', lbl: 'countries' },
      { num: '35%', lbl: 'faster feature development' },
    ],
  },
  {
    variant: 'split',
    theme: 'erneszt',
    kicker: 'Erneszt · Self-initiated · 2026',
    headline: 'AI-native products deliver a feeling, not features.',
    body: 'Three emotional moments designed before any interface: recognition, belonging, sharing. That sequence governed every decision that followed.',
    image: { src: '/work/erneszt/automaton.webp', alt: 'The Erneszt automaton' },
  },
  {
    variant: 'statement',
    theme: 'erneszt',
    kicker: 'Erneszt · Conversation architecture',
    headline: 'A prompt is a design artifact.',
    body: 'Five phases, each fully specified, like a user flow or a component library. Two of them the user never sees: they are what makes the rest feel prescient.',
  },
  {
    variant: 'split',
    theme: 'erneszt',
    kicker: 'Erneszt · The illustration engine',
    headline: 'The system owns the style. The model owns the subject.',
    body: 'Every card is generated for one person, out of what they actually said. The same contract a design system makes with its teams: freedom inside the constraint, no vote on the constraint.',
    image: { src: '/work/erneszt/trading-cards.webp', alt: 'Archetype cards in the automaton’s Art Nouveau visual language' },
  },
  {
    variant: 'close',
    kicker: 'Why BBVA',
    headline: 'Design at the table where decisions are made.',
    body: 'Two of BBVA’s strategic priorities are this exact thesis: making the most of AI, and a radical customer perspective. That is the work I want to do next.',
    meta: 'Erneszt is live · erneszt.com',
  },
];
---

<Base title="Present · Manu Barranco" description="Portfolio, presented.">
  <main class="deck" aria-label="Portfolio presentation">
    {slides.map((s, i) => (
      <section
        class={`slide v-${s.variant}`}
        data-theme={s.theme}
        data-slide={i}
        aria-hidden={i === 0 ? 'false' : 'true'}
      >
        <div class="slide-inner">
          <p class="kicker">{s.kicker}</p>

          {s.variant === 'gallery' || s.variant === 'split' ? (
            <div class="cols">
              <div class="text">
                <h2 class="headline">{s.headline}</h2>
                {s.quote && <p class="quote">&ldquo;{s.quote}&rdquo;</p>}
                {s.body && <p class="body">{s.body}</p>}
              </div>
              <div class="media">
                {s.image && (
                  <button type="button" class="shot-zoom" aria-label={`Enlarge: ${s.image.alt}`}>
                    <img src={s.image.src} alt={s.image.alt} loading="eager" />
                  </button>
                )}
                {s.images &&
                  s.images.map((img) => (
                    <button type="button" class="shot-zoom" aria-label={`Enlarge: ${img.alt}`}>
                      <img src={img.src} alt={img.alt} loading="eager" />
                    </button>
                  ))}
              </div>
            </div>
          ) : (
            <div class="text">
              <h2 class="headline">{s.headline}</h2>
              {s.body && <p class="body">{s.body}</p>}
              {s.items && (
                <ol class="arc-list">
                  {s.items.map((it) => (
                    <li>
                      <span class="mono arc-index">{it.index}</span>
                      <span class="arc-title">{it.title}</span>
                      <span class="arc-label">{it.label}</span>
                    </li>
                  ))}
                </ol>
              )}
              {s.metrics && (
                <div class="metrics">
                  {s.metrics.map((m) => (
                    <div class="metric">
                      <span class="num">{m.num}</span>
                      <span class="lbl">{m.lbl}</span>
                    </div>
                  ))}
                </div>
              )}
              {s.meta && <p class="meta mono">{s.meta}</p>}
            </div>
          )}
        </div>
      </section>
    ))}

    <!-- Lightbox: one image at a time, no carousel — the deck itself is the sequence.
         Native <dialog> buys Esc-to-close, focus trap and focus restore; the script
         copies the active slide's data-theme onto it so it stays in-universe. -->
    <dialog class="lb" aria-label="Image viewer">
      <div class="lb-stage">
        <img class="lb-img" src="" alt="" draggable="false" />
      </div>
      <div class="lb-bar">
        <p class="lb-cap"></p>
        <div class="lb-tools">
          <button type="button" class="lb-btn lb-out" aria-label="Zoom out">&minus;</button>
          <span class="lb-zoom mono" role="status" aria-live="polite"></span>
          <button type="button" class="lb-btn lb-in" aria-label="Zoom in">+</button>
          <button type="button" class="lb-btn lb-close" aria-label="Close viewer">&#10005;</button>
        </div>
      </div>
    </dialog>

    <div class="hud" data-theme="">
      <div class="progress" aria-hidden="true"><span class="bar"></span></div>
      <p class="hint mono" aria-hidden="true">&larr; &rarr; navigate &middot; esc exits</p>
      <div class="controls">
        <button class="ctrl prev mono" aria-label="Previous slide">&larr;</button>
        <span class="counter mono" aria-live="polite">01 / {String(slides.length).padStart(2, '0')}</span>
        <button class="ctrl next mono" aria-label="Next slide">&rarr;</button>
      </div>
    </div>
  </main>
</Base>

<style>
  .deck {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--color-core-background-default);
  }

  .slide {
    position: absolute;
    inset: 0;
    background: var(--color-core-background-default);
    color: var(--color-core-foreground-default);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 0.5s;
    display: flex;
    align-items: stretch;
  }
  .slide.active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 1;
  }

  .slide-inner {
    width: 100%;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: clamp(40px, 7vh, 84px) var(--space-gutter) clamp(96px, 14vh, 140px);
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 4vh, 40px);
    min-height: 0;
  }

  .kicker {
    font-family: var(--font-family-mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent-default);
    border-bottom: 1.5px solid var(--color-core-border-strong);
    padding-bottom: 14px;
  }

  .headline {
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-headline);
    font-size: clamp(34px, 5.4vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.015em;
    max-width: 18ch;
    text-wrap: balance;
  }
  .v-title .headline,
  .v-close .headline {
    font-size: clamp(40px, 6.4vw, 88px);
    max-width: 16ch;
  }

  .body {
    font-size: clamp(16px, 1.7vw, 21px);
    line-height: 1.5;
    color: var(--color-core-foreground-muted);
    max-width: 56ch;
  }

  .quote {
    font-family: var(--font-family-headline);
    font-weight: var(--font-weight-headline);
    font-size: clamp(20px, 2.4vw, 30px);
    line-height: 1.25;
    color: var(--color-accent-default);
    max-width: 26ch;
  }

  .meta {
    color: var(--color-core-foreground-subtle);
    letter-spacing: 0.03em;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 3vh, 28px);
    justify-content: center;
    min-height: 0;
  }
  .v-title .text,
  .v-close .text,
  .v-statement .text,
  .v-arc .text,
  .v-metrics .text {
    flex: 1;
  }

  .cols {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }

  .media {
    align-self: center;
    justify-self: center;
    min-height: 0;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: center;
  }
  .shot-zoom {
    display: flex;
    padding: 0;
    border: 0;
    background: none;
    max-width: 100%;
    min-height: 0;
    cursor: zoom-in;
  }
  .shot-zoom:focus-visible { outline: var(--border-width-strong) solid var(--color-accent-strong); outline-offset: 4px; }
  .media img {
    max-width: 100%;
    min-height: 0;
    object-fit: contain;
    border: 1.5px solid var(--color-core-border-default);
    border-radius: var(--radius-surface);
    box-shadow: var(--shadow-card);
    background: var(--color-core-background-subtle);
  }
  .v-split .media img { max-height: 58vh; }
  .v-gallery .media { flex-direction: row; }
  .v-gallery .media .shot-zoom { width: calc(50% - 10px); }
  .v-gallery .media img { max-height: 46vh; width: 100%; }

  .arc-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 40px);
    margin-top: clamp(8px, 2vh, 24px);
  }
  .arc-list li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: var(--border-width-strong) solid var(--color-core-border-strong);
    padding-top: 18px;
  }
  .arc-index { color: var(--color-accent-default); }
  .arc-title {
    font-family: var(--font-family-display);
    font-weight: var(--font-weight-headline);
    font-size: clamp(24px, 2.8vw, 40px);
    line-height: 1;
  }
  .arc-label {
    font-size: clamp(14px, 1.4vw, 17px);
    color: var(--color-core-foreground-muted);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 2.5vw, 32px);
    margin-top: clamp(8px, 2vh, 24px);
  }
  .metric {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: var(--border-width-strong) solid var(--color-core-border-strong);
    padding-top: 16px;
  }
  .metric .num {
    font-family: var(--font-family-headline);
    font-weight: var(--font-weight-headline);
    font-size: clamp(40px, 5vw, 68px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-accent-default);
  }
  .metric .lbl {
    font-family: var(--font-family-mono);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-core-foreground-muted);
  }

  /* HUD sits above every slide; its colors follow the active slide's theme,
     which the script copies onto it so counter and bar never lose contrast. */
  .hud {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 var(--space-gutter) 26px;
    pointer-events: none;
    color: var(--color-core-foreground-default);
  }
  .progress {
    position: absolute;
    top: auto;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: var(--color-core-border-default);
  }
  .progress .bar {
    display: block;
    height: 100%;
    width: 0;
    background: var(--color-accent-default);
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hint {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-core-foreground-subtle);
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 14px;
    pointer-events: auto;
  }
  .counter {
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--color-core-foreground-muted);
  }
  .ctrl {
    font-size: 15px;
    line-height: 1;
    padding: 9px 13px;
    background: transparent;
    color: var(--color-core-foreground-default);
    border: 1.5px solid var(--color-core-border-strong);
    border-radius: var(--radius-surface);
    cursor: pointer;
    transition: background 0.12s, color 0.12s;
  }
  .ctrl:hover {
    background: var(--color-accent-strong);
    color: var(--color-on-accent);
    border-color: var(--color-accent-strong);
  }

  /* ── lightbox — same mechanics as the case-study viewer, minus the carousel.
     Zoom is an explicit pixel width inside a scrolling stage (not a transform):
     panning rides on native scrolling, so trackpad, scrollbar and drag all behave. */
  .lb {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: var(--color-core-background-default);
    color: var(--color-core-foreground-default);
    overflow: hidden;
  }
  .lb::backdrop { background: rgba(0, 0, 0, 0.82); }
  .lb:not([open]) { display: none; }

  .lb-stage {
    position: absolute;
    inset: 0 0 var(--lb-bar-h, 68px);
    display: flex;
    overflow: auto;
    overscroll-behavior: contain;
    touch-action: none;
    background: var(--color-core-background-subtle);
  }
  .lb-img {
    margin: auto;
    display: block;
    max-width: none;
    height: auto;
    flex: none;
  }
  .lb-stage.is-zoomed { cursor: grab; }
  .lb-stage.is-panning { cursor: grabbing; }

  .lb-bar {
    position: absolute;
    inset: auto 0 0 0;
    min-height: var(--lb-bar-h, 68px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px 20px;
    border-top: 1.5px solid var(--color-core-border-strong);
    background: var(--color-core-background-default);
  }
  .lb-cap {
    font-family: var(--font-family-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-core-foreground-subtle);
    margin: 0;
  }
  .lb-tools { display: flex; align-items: center; gap: 8px; flex: none; }
  .lb-zoom {
    font-size: 11px;
    letter-spacing: 0.03em;
    color: var(--color-core-foreground-subtle);
    min-width: 44px;
    text-align: center;
  }
  .lb-btn {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    font-family: var(--font-family-body);
    font-size: 16px;
    line-height: 1;
    color: var(--color-core-foreground-default);
    background: none;
    border: var(--border-width-strong) solid var(--color-core-border-default);
    border-radius: var(--radius-surface);
    cursor: pointer;
    transition: background 0.12s, color 0.12s;
  }
  .lb-btn:hover { background: var(--color-accent-strong); color: var(--color-on-accent); border-color: var(--color-accent-strong); }
  .lb-btn:focus-visible { outline: var(--border-width-strong) solid var(--color-accent-strong); outline-offset: 2px; }

  @media (max-width: 860px) {
    .cols { grid-template-columns: 1fr; align-items: start; }
    .v-split .media img { max-height: 34vh; }
    .v-gallery .media img { max-height: 26vh; }
    .arc-list, .metrics { grid-template-columns: repeat(2, 1fr); }
    .hint { display: none; }
  }
</style>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const hud = document.querySelector<HTMLElement>('.hud')!;
  const counter = document.querySelector<HTMLElement>('.counter')!;
  const bar = document.querySelector<HTMLElement>('.progress .bar')!;
  const pad = (n: number) => String(n).padStart(2, '0');

  let current = Math.min(Math.max(parseInt(location.hash.slice(1), 10) || 0, 0), slides.length - 1);

  function go(n: number) {
    current = Math.min(Math.max(n, 0), slides.length - 1);
    slides.forEach((s, i) => {
      s.classList.toggle('active', i === current);
      s.setAttribute('aria-hidden', i === current ? 'false' : 'true');
    });
    // hand the active slide's universe to the HUD so its tokens re-resolve
    hud.setAttribute('data-theme', slides[current].getAttribute('data-theme') || '');
    counter.textContent = `${pad(current + 1)} / ${pad(slides.length)}`;
    bar.style.width = `${((current + 1) / slides.length) * 100}%`;
    history.replaceState(null, '', `#${current}`);
  }

  const dlg = document.querySelector<HTMLDialogElement>('.lb')!;

  document.addEventListener('keydown', (e) => {
    // while the lightbox is open the deck goes quiet: the first Esc closes the viewer,
    // and only the next one, with the deck back in charge, exits to the site
    if (dlg.open) {
      if (e.key === 'Escape') { e.preventDefault(); dlg.close(); }
      return;
    }
    if (e.key === ' ' && (e.target as HTMLElement).closest?.('button')) return;
    if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') { e.preventDefault(); go(current + 1); }
    else if (e.key === 'ArrowLeft' || e.key === 'PageUp') { e.preventDefault(); go(current - 1); }
    else if (e.key === 'Home') { e.preventDefault(); go(0); }
    else if (e.key === 'End') { e.preventDefault(); go(slides.length - 1); }
    else if (e.key === 'Escape') { window.location.href = '/'; }
  });

  // click anywhere advances; the explicit controls go both ways, images open the viewer
  document.querySelector('.deck')!.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.ctrl, a, .shot-zoom, .lb')) return;
    go(current + 1);
  });
  document.querySelector('.ctrl.prev')!.addEventListener('click', () => go(current - 1));
  document.querySelector('.ctrl.next')!.addEventListener('click', () => go(current + 1));

  go(current);

  /* ── lightbox: zoom as pixel width inside a scrolling stage, same approach as the
     case-study viewer. Pinch (ctrl+wheel) zooms around the pointer, plain two-finger
     scroll pans natively, drag pans, double-click toggles fit ↔ 100%. */
  const stage = dlg.querySelector<HTMLElement>('.lb-stage')!;
  const lbImg = dlg.querySelector<HTMLImageElement>('.lb-img')!;
  const capEl = dlg.querySelector<HTMLElement>('.lb-cap')!;
  const zoomEl = dlg.querySelector<HTMLElement>('.lb-zoom')!;

  let scale = 1;
  let fitScale = 1;

  function applyScale(next: number, focusX?: number, focusY?: number) {
    const nw = lbImg.naturalWidth || 1;
    const clamped = Math.min(Math.max(next, fitScale), Math.max(fitScale * 6, 4));
    const prevW = lbImg.clientWidth || nw * scale;
    const fx = focusX ?? stage.clientWidth / 2;
    const fy = focusY ?? stage.clientHeight / 2;
    const ratioX = (stage.scrollLeft + fx) / Math.max(prevW, 1);
    const ratioY = (stage.scrollTop + fy) / Math.max(lbImg.clientHeight || 1, 1);

    scale = clamped;
    lbImg.style.width = `${nw * scale}px`;
    stage.scrollLeft = ratioX * lbImg.clientWidth - fx;
    stage.scrollTop = ratioY * lbImg.clientHeight - fy;

    zoomEl.textContent = `${Math.round(scale * 100)}%`;
    stage.classList.toggle('is-zoomed', scale > fitScale + 0.001);
  }

  function fitToStage() {
    const nw = lbImg.naturalWidth;
    const nh = lbImg.naturalHeight;
    if (!nw || !nh) return;
    /* never upscale on open: a small screenshot blown up to fill the stage looks broken */
    fitScale = Math.min(stage.clientWidth / nw, stage.clientHeight / nh, 1);
    scale = fitScale;
    lbImg.style.width = `${nw * fitScale}px`;
    zoomEl.textContent = `${Math.round(scale * 100)}%`;
    stage.classList.remove('is-zoomed');
  }

  lbImg.addEventListener('load', fitToStage);

  document.querySelectorAll<HTMLButtonElement>('.shot-zoom').forEach((btn) => {
    btn.addEventListener('click', () => {
      const img = btn.querySelector('img')!;
      // stay in the slide's universe: the dialog carries the same theme tokens
      dlg.setAttribute('data-theme', btn.closest('.slide')?.getAttribute('data-theme') || '');
      lbImg.style.width = '';
      lbImg.src = img.currentSrc || img.src;
      lbImg.alt = img.alt;
      capEl.textContent = img.alt;
      dlg.showModal();
      if (lbImg.complete && lbImg.naturalWidth) fitToStage();
    });
  });

  dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
  dlg.querySelector('.lb-in')!.addEventListener('click', () => applyScale(scale * 1.4));
  dlg.querySelector('.lb-out')!.addEventListener('click', () => applyScale(scale / 1.4));

  // click the backdrop (the dialog itself, outside the stage) to dismiss
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) dlg.close();
  });

  stage.addEventListener('dblclick', (e) => {
    const r = stage.getBoundingClientRect();
    applyScale(scale > fitScale + 0.001 ? fitScale : Math.max(1, fitScale * 2), e.clientX - r.left, e.clientY - r.top);
  });

  stage.addEventListener(
    'wheel',
    (e) => {
      /* trackpad pinch and ctrl+wheel arrive as wheel events with ctrlKey set; plain
         wheel is left alone so a two-finger scroll still pans the zoomed image */
      if (!e.ctrlKey) return;
      e.preventDefault();
      const r = stage.getBoundingClientRect();
      applyScale(scale * (e.deltaY < 0 ? 1.12 : 1 / 1.12), e.clientX - r.left, e.clientY - r.top);
    },
    { passive: false },
  );

  // drag to pan, and two-finger pinch to zoom (touch)
  const pointers = new Map<number, { x: number; y: number }>();
  let pinchStart = 0;
  let pinchScale = 1;
  let panFrom: { x: number; y: number; left: number; top: number } | null = null;

  function pinchDistance() {
    const [a, b] = Array.from(pointers.values());
    return Math.hypot(a.x - b.x, a.y - b.y);
  }

  stage.addEventListener('pointerdown', (e) => {
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pointers.size === 2) {
      pinchStart = pinchDistance();
      pinchScale = scale;
      panFrom = null;
    } else if (pointers.size === 1) {
      panFrom = { x: e.clientX, y: e.clientY, left: stage.scrollLeft, top: stage.scrollTop };
    }
  });

  stage.addEventListener('pointermove', (e) => {
    if (!pointers.has(e.pointerId)) return;
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

    if (pointers.size === 2 && pinchStart > 0) {
      e.preventDefault();
      const [a, b] = Array.from(pointers.values());
      const r = stage.getBoundingClientRect();
      applyScale((pinchScale * pinchDistance()) / pinchStart, (a.x + b.x) / 2 - r.left, (a.y + b.y) / 2 - r.top);
      return;
    }

    if (panFrom && pointers.size === 1) {
      const dx = e.clientX - panFrom.x;
      const dy = e.clientY - panFrom.y;
      if (stage.scrollWidth > stage.clientWidth || stage.scrollHeight > stage.clientHeight) {
        e.preventDefault();
        stage.scrollLeft = panFrom.left - dx;
        stage.scrollTop = panFrom.top - dy;
        stage.classList.add('is-panning');
      }
    }
  });

  function endPointer(e: PointerEvent) {
    pointers.delete(e.pointerId);
    if (pointers.size < 2) pinchStart = 0;
    if (pointers.size === 0) {
      panFrom = null;
      stage.classList.remove('is-panning');
    }
  }
  stage.addEventListener('pointerup', endPointer);
  stage.addEventListener('pointercancel', endPointer);

  window.addEventListener('resize', () => { if (dlg.open) fitToStage(); }, { passive: true });
</script>
