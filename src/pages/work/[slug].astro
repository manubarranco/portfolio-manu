---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const items = await getCollection('work');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
---

<Base title={`${d.title} · Manu Barranco`} description={d.summary}>
  <Nav />
  <article class={`cs${d.aiNative ? ' is-ai' : ''}`} data-theme={item.id}>
    <header class="cs-head wrap">
      <p class="eyebrow">{d.category}</p>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
    </header>

    <div class="cs-body wrap">
      <aside class="meta" aria-label="Project details">
        <div><span class="k mono">Client</span><span class="v">{d.client}</span></div>
        <div><span class="k mono">Year</span><span class="v">{d.years}</span></div>
        <div><span class="k mono">Timeframe</span><span class="v">{d.timeframe}</span></div>
        <div><span class="k mono">Category</span><span class="v">{d.category}</span></div>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="cs-foot wrap" aria-label="Case study">
      <a href="/#work">← All work</a>
    </nav>

    <!-- Lightbox. Lives inside <article> so it inherits the case's data-theme tokens;
         showModal() lifts it to the top layer regardless of where it sits in the DOM.
         Native <dialog> buys us Esc-to-close, the backdrop, the focus trap and focus
         restore to the thumbnail that opened it. -->
    <dialog class="lb" aria-label="Image viewer">
      <div class="lb-stage">
        <img class="lb-img" src="" alt="" draggable="false" />
      </div>

      <button type="button" class="lb-nav lb-prev" aria-label="Previous image">←</button>
      <button type="button" class="lb-nav lb-next" aria-label="Next image">→</button>

      <div class="lb-bar">
        <p class="lb-cap"></p>
        <div class="lb-tools">
          <span class="lb-count mono" aria-hidden="true"></span>
          <button type="button" class="lb-btn lb-out" aria-label="Zoom out">−</button>
          <span class="lb-zoom mono" role="status" aria-live="polite"></span>
          <button type="button" class="lb-btn lb-in" aria-label="Zoom in">+</button>
          <button type="button" class="lb-btn lb-close" aria-label="Close viewer">✕</button>
        </div>
      </div>
    </dialog>
  </article>
  <Footer />
</Base>

<script>
  /* show the diagram scroll hint only when a diagram actually overflows its container —
     re-checked on resize since the 640px mobile floor may or may not exceed the viewport
     depending on exact width */
  function checkDiagramOverflow() {
    document.querySelectorAll('.diagram-scroll').forEach((el) => {
      const figure = el.closest('figure.diagram');
      if (!figure) return;
      figure.classList.toggle('is-scrollable', el.scrollWidth > el.clientWidth + 1);
    });
  }
  checkDiagramOverflow();
  window.addEventListener('resize', checkDiagramOverflow, { passive: true });

  /* ── lightbox: click any case-study shot to open it full screen, then zoom and pan.
     Zoom is applied as an explicit pixel width on the image inside a scrolling stage
     (not a CSS transform): panning then rides on native scrolling, which is what makes
     a trackpad, a scrollbar and a dragging finger all behave the way people expect. */
  const dlg = document.querySelector('.lb') as HTMLDialogElement | null;
  const shots = Array.from(
    document.querySelectorAll<HTMLImageElement>('.prose figure.shot img'),
  );

  if (dlg && shots.length && typeof dlg.showModal === 'function') {
    const stage = dlg.querySelector('.lb-stage') as HTMLElement;
    const lbImg = dlg.querySelector('.lb-img') as HTMLImageElement;
    const capEl = dlg.querySelector('.lb-cap') as HTMLElement;
    const countEl = dlg.querySelector('.lb-count') as HTMLElement;
    const zoomEl = dlg.querySelector('.lb-zoom') as HTMLElement;
    const prevBtn = dlg.querySelector('.lb-prev') as HTMLButtonElement;
    const nextBtn = dlg.querySelector('.lb-next') as HTMLButtonElement;

    /* Astro's scoped styles only match elements carrying its data-astro-cid-* attribute,
       which nodes built with createElement never get — copy it off an element the
       compiler did stamp so the generated buttons pick up the .shot-zoom rules. */
    const cid = stage.getAttributeNames().find((n) => n.startsWith('data-astro-cid'));

    const items = shots.map((img) => {
      const fig = img.closest('figure');
      const caption = fig?.querySelector('figcaption')?.textContent?.trim() || '';
      return { src: img.currentSrc || img.src, alt: img.alt || '', caption };
    });

    let index = 0;
    let scale = 1;      /* multiplier over the image's natural width */
    let fitScale = 1;   /* the scale at which it fits the stage; also the lower bound */

    function applyScale(next: number, focusX?: number, focusY?: number) {
      const nw = lbImg.naturalWidth || 1;
      const clamped = Math.min(Math.max(next, fitScale), Math.max(fitScale * 6, 4));
      const prevW = lbImg.clientWidth || nw * scale;
      /* keep whatever sits under the pointer (or under the pinch center) pinned in place:
         convert it to a fraction of the content, then put that fraction back under it */
      const fx = focusX ?? stage.clientWidth / 2;
      const fy = focusY ?? stage.clientHeight / 2;
      const ratioX = (stage.scrollLeft + fx) / Math.max(prevW, 1);
      const ratioY = (stage.scrollTop + fy) / Math.max(lbImg.clientHeight || 1, 1);

      scale = clamped;
      lbImg.style.width = `${nw * scale}px`;

      stage.scrollLeft = ratioX * lbImg.clientWidth - fx;
      stage.scrollTop = ratioY * lbImg.clientHeight - fy;

      zoomEl.textContent = `${Math.round(scale * 100)}%`;
      stage.classList.toggle('is-zoomed', scale > fitScale + 0.001);
    }

    function fitToStage() {
      const nw = lbImg.naturalWidth;
      const nh = lbImg.naturalHeight;
      if (!nw || !nh) return;
      /* never upscale on open: a small screenshot blown up to fill the stage just looks broken */
      fitScale = Math.min(stage.clientWidth / nw, stage.clientHeight / nh, 1);
      scale = fitScale;
      lbImg.style.width = `${nw * fitScale}px`;
      zoomEl.textContent = `${Math.round(scale * 100)}%`;
      stage.classList.remove('is-zoomed');
    }

    function show(i: number) {
      index = (i + items.length) % items.length;
      const it = items[index];
      lbImg.style.width = '';
      lbImg.src = it.src;
      lbImg.alt = it.alt;
      capEl.textContent = it.caption;
      countEl.textContent = items.length > 1 ? `${index + 1} / ${items.length}` : '';
      prevBtn.hidden = nextBtn.hidden = items.length < 2;
      if (lbImg.complete && lbImg.naturalWidth) fitToStage();
    }

    lbImg.addEventListener('load', fitToStage);

    shots.forEach((img, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'shot-zoom';
      btn.setAttribute(
        'aria-label',
        items[i].caption ? `Enlarge: ${items[i].caption}` : 'Enlarge image',
      );
      if (cid) btn.setAttribute(cid, '');
      img.parentNode?.insertBefore(btn, img);
      btn.appendChild(img);
      btn.addEventListener('click', () => {
        show(i);
        dlg.showModal();
        fitToStage();
      });
    });

    dlg.querySelector('.lb-close')?.addEventListener('click', () => dlg.close());
    dlg.querySelector('.lb-in')?.addEventListener('click', () => applyScale(scale * 1.4));
    dlg.querySelector('.lb-out')?.addEventListener('click', () => applyScale(scale / 1.4));
    prevBtn.addEventListener('click', () => show(index - 1));
    nextBtn.addEventListener('click', () => show(index + 1));

    /* click the backdrop (i.e. the dialog itself, outside the stage) to dismiss */
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });

    /* double-click / double-tap toggles between fit and 100% (or back to fit if already there) */
    stage.addEventListener('dblclick', (e) => {
      const r = stage.getBoundingClientRect();
      applyScale(scale > fitScale + 0.001 ? fitScale : Math.max(1, fitScale * 2), e.clientX - r.left, e.clientY - r.top);
    });

    stage.addEventListener(
      'wheel',
      (e) => {
        /* trackpad pinch and ctrl+wheel arrive as wheel events with ctrlKey set; plain
           wheel is left alone so a two-finger scroll still pans the zoomed image */
        if (!e.ctrlKey) return;
        e.preventDefault();
        const r = stage.getBoundingClientRect();
        applyScale(scale * (e.deltaY < 0 ? 1.12 : 1 / 1.12), e.clientX - r.left, e.clientY - r.top);
      },
      { passive: false },
    );

    /* drag to pan, and two-finger pinch to zoom */
    const pointers = new Map<number, { x: number; y: number }>();
    let pinchStart = 0;
    let pinchScale = 1;
    let panFrom: { x: number; y: number; left: number; top: number } | null = null;

    function pinchDistance() {
      const [a, b] = Array.from(pointers.values());
      return Math.hypot(a.x - b.x, a.y - b.y);
    }

    stage.addEventListener('pointerdown', (e) => {
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size === 2) {
        pinchStart = pinchDistance();
        pinchScale = scale;
        panFrom = null;
      } else if (pointers.size === 1) {
        panFrom = { x: e.clientX, y: e.clientY, left: stage.scrollLeft, top: stage.scrollTop };
      }
    });

    stage.addEventListener('pointermove', (e) => {
      if (!pointers.has(e.pointerId)) return;
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

      if (pointers.size === 2 && pinchStart > 0) {
        e.preventDefault();
        const [a, b] = Array.from(pointers.values());
        const r = stage.getBoundingClientRect();
        applyScale(
          (pinchScale * pinchDistance()) / pinchStart,
          (a.x + b.x) / 2 - r.left,
          (a.y + b.y) / 2 - r.top,
        );
        return;
      }

      if (panFrom && pointers.size === 1) {
        const dx = e.clientX - panFrom.x;
        const dy = e.clientY - panFrom.y;
        if (stage.scrollWidth > stage.clientWidth || stage.scrollHeight > stage.clientHeight) {
          e.preventDefault();
          stage.scrollLeft = panFrom.left - dx;
          stage.scrollTop = panFrom.top - dy;
          stage.classList.add('is-panning');
        }
      }
    });

    function endPointer(e: PointerEvent) {
      pointers.delete(e.pointerId);
      if (pointers.size < 2) pinchStart = 0;
      if (pointers.size === 0) {
        panFrom = null;
        stage.classList.remove('is-panning');
      }
    }
    stage.addEventListener('pointerup', endPointer);
    stage.addEventListener('pointercancel', endPointer);

    dlg.addEventListener('keydown', (e) => {
      if (items.length < 2) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
    });

    window.addEventListener('resize', () => { if (dlg.open) fitToStage(); }, { passive: true });
  }
</script>

<style>
  /* re-anchor the themed vars here: `data-theme` on <article> redefines the custom
     properties for its subtree, but `color`/`background` inherited from <body> already
     resolved against the untouched :root values — only elements that reference the vars
     directly inside the scope pick up the new theme. */
  .cs { background: var(--color-core-background-default); color: var(--color-core-foreground-default); font-family: var(--font-family-body); padding-bottom: 64px; }
  .cs-head { padding-top: 64px; }
  .cs-head .eyebrow { color: var(--color-accent-strong); }
  .cs-head h1 { font-family: var(--font-family-display); font-weight: 800; font-size: clamp(48px, 10vw, 104px); line-height: 0.94; letter-spacing: -0.02em; margin: 18px 0; }
  .cs-head .summary { font-weight: 500; font-size: clamp(20px, 2.6vw, 28px); line-height: 1.32; letter-spacing: -0.015em; max-width: 24ch; }

  .cs-body {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 64px;
    margin-top: 56px;
    border-top: 1.5px solid var(--color-core-border-strong);
    padding-top: 40px;
  }
  .meta { display: flex; flex-direction: column; gap: 22px; position: sticky; top: 32px; align-self: start; }
  .meta .k { display: block; color: var(--color-accent-strong); text-transform: uppercase; font-size: 11px; letter-spacing: 0.03em; margin-bottom: 6px; }
  .meta .v { font-size: 15px; }

  .cs-foot { display: flex; justify-content: space-between; margin-top: 80px; padding-top: 28px; border-top: 1.5px solid var(--color-core-border-default); font-family: var(--font-family-mono); font-size: 13px; }
  .cs-foot a { transition: color 0.12s, background 0.12s, box-shadow 0.12s; }
  .cs-foot a:hover { background: var(--color-accent-default); color: var(--color-core-background-default); box-shadow: 0 0 0 0.12em var(--color-accent-default); }

  /* prose */
  .prose { max-width: 70ch; font-size: 18px; line-height: 1.7; }
  .prose :global(h2) { font-family: var(--font-family-headline); font-weight: var(--font-weight-headline); font-size: clamp(34px, 4.4vw, 50px); line-height: 1.0; letter-spacing: -0.02em; margin: 1.8em 0 0.7em; padding-bottom: 0.1em; border-bottom: 2px solid var(--color-accent-default); }
  .prose :global(h3) { font-family: var(--font-family-headline); font-weight: var(--font-weight-headline); font-size: clamp(26px, 3vw, 32px); line-height: 1.0; letter-spacing: -0.02em; margin: 1.7em 0 0.3em; }
  .prose :global(h2:first-child), .prose :global(h3:first-child) { margin-top: 0; }
  .prose :global(p) { margin: 0 0 1.1em; }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(em) { font-style: italic; }
  .prose :global(a) { color: var(--color-accent-strong); text-decoration: underline; text-underline-offset: 3px; transition: color 0.12s, background 0.12s, box-shadow 0.12s; }
  .prose :global(a:hover) { background: var(--color-accent-default); color: var(--color-core-background-default); text-decoration-color: transparent; box-shadow: 0 0 0 0.08em var(--color-accent-default); }
  .prose :global(ul) { margin: 0 0 1.2em; padding-left: 1.1em; }
  .prose :global(li) { margin: 0.35em 0; }
  .prose :global(blockquote) {
    font-family: var(--font-family-display);
    font-weight: 600;
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 1.5em 0;
    padding-left: 22px;
    border-left: 3px solid var(--color-accent-default);
    border-radius: 0;
  }
  .prose :global(blockquote p) { margin: 0; }

  .prose :global(.metrics) {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-core-border-default);
    border: 1px solid var(--color-core-border-default);
    margin: 2em 0;
  }
  .prose :global(.metric) { background: var(--color-core-background-default); padding: 22px 18px; display: flex; flex-direction: column; gap: 6px; }
  .prose :global(.metric .num) { font-family: var(--font-family-headline); font-weight: var(--font-weight-headline); font-size: clamp(36px, 4.6vw, 52px); line-height: 0.95; letter-spacing: -0.02em; color: var(--color-accent-default); }
  .prose :global(.metric .lbl) { font-family: var(--font-family-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--color-core-foreground-muted); }

  .prose :global(.video) { position: relative; aspect-ratio: 16 / 9; margin: 2em 0; border: 1.5px solid var(--color-core-border-strong); background: var(--color-core-foreground-default); }
  .prose :global(.video iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  .prose :global(.callout) {
    font-family: var(--font-family-mono);
    font-size: 14px;
    line-height: 1.5;
    border: 1.5px solid var(--color-core-border-strong);
    padding: 16px 20px;
    margin: 1.8em 0;
  }
  .prose :global(.callout strong) { color: var(--color-accent-strong); font-weight: 700; }

  /* diagrams — inline SVGs themed via the case's data-theme vars */
  .prose :global(figure.diagram) { margin: 2.4em 0; }
  /* .diagram-frame (not the figure, which also contains the figcaption below) is the
     positioning context for the hint badge, so it hugs the bottom-right of the image itself
     rather than the bottom of the whole figure. .diagram-scroll is the actual scroll
     container, kept separate so the badge — a sibling, not its child — stays pinned in place
     as the user scrolls the diagram instead of scrolling away with it. */
  .prose :global(figure.diagram .diagram-frame) { position: relative; }
  .prose :global(figure.diagram .diagram-scroll) { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .prose :global(figure.diagram svg) { display: block; width: 100%; height: auto; }
  .prose :global(figure.diagram figcaption) { font-family: var(--font-family-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--color-core-foreground-subtle); margin-top: 10px; }
  /* scroll affordance — only shown (via .is-scrollable, toggled in the script below) when the
     diagram actually overflows. A solid filled chip, unlike the diagram's own flat inline
     labels, so it doesn't read as one more piece of the diagram content. */
  .prose :global(figure.diagram .diagram-hint) {
    display: none;
    position: absolute;
    right: 10px;
    bottom: 10px;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    font-family: var(--font-family-mono);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-on-accent);
    background: var(--color-accent-strong);
    border-radius: var(--radius-surface);
    box-shadow: var(--shadow-card);
  }
  .prose :global(figure.diagram.is-scrollable .diagram-hint) { display: inline-flex; }
  .prose :global(figure.diagram .diagram-hint-arrow) { display: inline-block; animation: diagram-hint-nudge 1.4s ease-in-out infinite; }
  @keyframes diagram-hint-nudge {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .prose :global(figure.diagram .diagram-hint-arrow) { animation: none; }
  }
  .prose :global(svg .dg-stroke) { stroke: var(--color-accent-default); fill: none; stroke-width: 1.5; }
  .prose :global(svg .dg-stroke--soft) { stroke: var(--color-core-foreground-subtle); fill: none; stroke-width: 1; }
  .prose :global(svg .dg-arrow) { fill: var(--color-accent-default); }
  .prose :global(svg .dg-panel) { fill: var(--color-core-background-subtle); stroke: var(--color-accent-default); stroke-width: 1.5; }
  .prose :global(svg .dg-panel--ghost) { fill: none; stroke: var(--color-core-foreground-subtle); stroke-width: 1; stroke-dasharray: 4 4; }
  .prose :global(svg .dg-title) { fill: var(--color-core-foreground-default); font-family: var(--font-family-headline); font-size: 19px; }
  .prose :global(svg .dg-body) { fill: var(--color-core-foreground-muted); font-family: var(--font-family-body); font-size: 12.5px; }
  .prose :global(svg .dg-label) { fill: var(--color-accent-strong); font-family: var(--font-family-mono); font-size: 10.5px; letter-spacing: 0.08em; }
  .prose :global(svg .dg-label--subtle) { fill: var(--color-core-foreground-subtle); font-family: var(--font-family-mono); font-size: 10.5px; letter-spacing: 0.08em; }
  .prose :global(svg .dg-dim) { opacity: 0.55; }
  .prose :global(svg .dg-x) { stroke: var(--color-core-foreground-subtle); stroke-width: 1.5; }

  .prose :global(figure.shot) { margin: 2.2em 0; }
  .prose :global(figure.shot img) { display: block; width: 100%; height: auto; border: 1.5px solid var(--color-core-border-default); background: var(--color-core-background-subtle); }

  /* ── zoom trigger: the script wraps every shot in this button (no-JS keeps a plain image) */
  .prose :global(.shot-zoom) {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    font: inherit;
    color: inherit;
  }
  /* affordance badge, mirroring the diagram scroll hint so the two read as the same family */
  .prose :global(.shot-zoom)::after {
    content: '⤢';
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    font-size: 14px;
    line-height: 1;
    color: var(--color-on-accent);
    background: var(--color-accent-strong);
    border-radius: var(--radius-surface);
    box-shadow: var(--shadow-card);
    opacity: 0;
    transition: opacity 0.14s ease;
  }
  .prose :global(.shot-zoom:hover)::after,
  .prose :global(.shot-zoom:focus-visible)::after { opacity: 1; }
  .prose :global(.shot-zoom:focus-visible) { outline: var(--border-width-strong) solid var(--color-accent-strong); outline-offset: 3px; }
  /* touch devices get no hover, so the badge has to be there from the start */
  @media (hover: none) {
    .prose :global(.shot-zoom)::after { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .prose :global(.shot-zoom)::after { transition: none; }
  }

  /* ── lightbox */
  .lb {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: var(--color-core-background-default);
    color: var(--color-core-foreground-default);
    overflow: hidden;
  }
  .lb::backdrop { background: rgba(0, 0, 0, 0.82); }
  .lb:not([open]) { display: none; }

  .lb-stage {
    position: absolute;
    inset: 0 0 var(--lb-bar-h, 68px);
    display: flex;
    overflow: auto;
    overscroll-behavior: contain;
    /* the pointer handlers own horizontal drag and pinch; leaving the browser its own
       gesture would fight them mid-drag */
    touch-action: none;
    background: var(--color-core-background-subtle);
  }
  .lb-img {
    margin: auto; /* centers while small, and unlike justify/align-center it does not clip
                     the top-left once the image outgrows the stage and starts scrolling */
    display: block;
    max-width: none;
    height: auto;
    /* flex-shrink is 1 by default and a replaced element's automatic minimum size is its
       intrinsic width: without this the stage silently clamps every zoom level above 100%
       back down to the file's natural width, and zooming in past 100% does nothing */
    flex: none;
  }
  .lb-stage.is-zoomed { cursor: grab; }
  .lb-stage.is-panning { cursor: grabbing; }

  .lb-bar {
    position: absolute;
    inset: auto 0 0 0;
    min-height: var(--lb-bar-h, 68px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px 20px;
    border-top: 1.5px solid var(--color-core-border-strong);
    background: var(--color-core-background-default);
  }
  .lb-cap {
    font-family: var(--font-family-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-core-foreground-subtle);
    margin: 0;
  }
